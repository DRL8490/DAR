<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Reporting Page - NMDC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f7f6; padding-top: 30px; }
        .wizard-card { border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: none; transition: transform 0.2s; }
        .wizard-card:hover { transform: translateY(-2px); box-shadow: 0 8px 15px rgba(0,0,0,0.08); }
        .card-header { color: white; border-radius: 12px 12px 0 0 !important; padding: 15px; font-weight: bold; text-align: center; }
        
        .bg-dtr { background: #0d6efd; } 
        .bg-kpi { background: #198754; } 
        .bg-preview { background: #343a40; }

        .date-chip { display: inline-flex; align-items: center; gap: 6px; background: #e7f1ff; color: #084298; border: 1px solid #b6d4fe; padding: 4px 10px; border-radius: 20px; font-size: 12.5px; font-weight: 700; }
        .date-chip-remove { cursor: pointer; color: #dc3545; font-weight: 900; line-height: 1; border: none; background: none; padding: 0 2px; }
        .date-chip-remove:hover { color: #a71d2a; }
        .quick-range-btn { font-size: 11.5px; font-weight: 700; padding: 3px 9px; border-radius: 15px; cursor: pointer; }
    </style>
</head>
<body>

<!-- WSR V13 AUTOMATION STUDIO MODULE CARD -->
<div style="background: linear-gradient(90deg, #0f2c59 0%, #0c4a6e 100%); color: #ffffff; border-radius: 12px; padding: 18px 22px; margin: 16px 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; box-shadow: 0 4px 12px rgba(15,44,89,0.18);">
  <div>
    <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #7dd3fc; font-weight: 700;">NMDC Project 20012 • 2-Week AI Context + Page-1 Admin Tables</div>
    <div style="font-size: 18px; font-weight: 800; margin-top: 2px;">Weekly Survey Report (WSR V13) Automation Studio</div>
    <div style="font-size: 12px; color: #e2e8f0; margin-top: 2px;">Pull 7-day closed SurveyTasks directly from the DPR database, edit Page-1 Personnel/Leave/Training tables, and generate pagination-locked Word &amp; PDF reports.</div>
  </div>
  <a href="/wsr" style="background-color: #10b981; color: #ffffff; font-weight: 700; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-size: 13px; white-space: nowrap; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
    🚀 Open WSR V13 Studio →
  </a>
</div>



<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold text-secondary mb-0"><i class="fas fa-chart-pie"></i> Survey Reporting Center</h2>
        <div class="d-flex gap-2">
            {% if session.get('dashboard_view') == 'admin' %}
            <a href="/usage_telemetry" class="btn btn-dark"><i class="fas fa-satellite-dish"></i> Usage Telemetry</a>
            {% endif %}
            <a href="{{ url_for('admin_dashboard') if session.get('dashboard_view') == 'admin' else url_for('dashboard') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        </div>
    </div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
                <div class="alert alert-{{ 'success' if category == 'success' else 'danger' }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endif %}
    {% endwith %}

    <div class="row mb-4">
        <!-- DTR GENERATOR (SINGLE OR MULTIPLE DATES IN ONE .DOCX FILE) -->
        <div class="col-md-6 mb-4">
            <div class="card wizard-card h-100">
                <div class="card-header bg-dtr"><h5 class="mb-0"><i class="fas fa-calendar-day"></i> DTR Generator (Single or Multi-Date)</h5></div>
                <div class="card-body d-flex flex-column">
                    <p class="small text-muted text-center mb-3">
                        Daily Task Report (.docx)<br>
                        <em>*Select a single date or add multiple dates / ranges into one combined Word file.</em>
                    </p>
                    <form action="/generate_dtr" method="POST" id="dtrForm" class="mt-auto" onsubmit="prepareDtrSubmit()">
                        <input type="hidden" name="selected_dates_csv" id="selectedDatesCsv">

                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold small mb-0">Target Date(s)</label>
                            <div class="d-flex gap-1 flex-wrap">
                                <button type="button" class="btn btn-outline-primary quick-range-btn" onclick="addQuickPreset(2)">+ Yesterday & Today</button>
                                <button type="button" class="btn btn-outline-primary quick-range-btn" onclick="addQuickPreset(3)">+ Past 3 Days</button>
                                <button type="button" class="btn btn-outline-primary quick-range-btn" onclick="addThisWeekPreset()">+ This Week</button>
                                <button type="button" class="btn btn-outline-secondary quick-range-btn" onclick="toggleRangeDrawer()">📅 Date Range</button>
                            </div>
                        </div>

                        <div class="input-group mb-2">
                            <input type="date" id="dtrDateInput" class="form-control" onchange="onSingleDateInputChange()">
                            <button type="button" class="btn btn-outline-primary fw-bold" onclick="addDateFromPicker()" title="Add this date to multi-date list">
                                <i class="fas fa-plus"></i> Add Date
                            </button>
                        </div>

                        <!-- Optional Collapsible Date Range Picker (From -> To) -->
                        <div id="rangeDrawer" style="display: none;" class="p-2 mb-2 bg-light border rounded">
                            <div class="row g-2 align-items-end">
                                <div class="col-5">
                                    <label class="form-label small fw-bold mb-1">From Date</label>
                                    <input type="date" id="rangeStartInput" class="form-control form-control-sm">
                                </div>
                                <div class="col-5">
                                    <label class="form-label small fw-bold mb-1">To Date</label>
                                    <input type="date" id="rangeEndInput" class="form-control form-control-sm">
                                </div>
                                <div class="col-2">
                                    <button type="button" class="btn btn-sm btn-primary fw-bold w-100" onclick="addDatesFromRange()">Add</button>
                                </div>
                            </div>
                        </div>

                        <!-- Selected Dates Pill Tray -->
                        <div class="p-2 bg-light border rounded mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold text-secondary" id="selectedDatesCountLabel">1 Date Selected:</span>
                                <a href="javascript:void(0)" class="small text-danger text-decoration-none fw-bold" onclick="resetToToday()">↺ Reset to Today</a>
                            </div>
                            <div id="selectedDatesTray" class="d-flex flex-wrap gap-1"></div>
                        </div>

                        <!-- Multi-Date Formatting Options -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 px-1">
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="checkbox" name="page_break" id="chkPageBreak" value="true" checked>
                                <label class="form-check-label small text-muted" for="chkPageBreak">Page break between dates</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="checkbox" name="skip_empty" id="chkSkipEmpty" value="true">
                                <label class="form-check-label small text-muted" for="chkSkipEmpty">Skip dates with 0 tasks</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold" id="btnGenerateDtr">
                            <i class="fas fa-download"></i> Generate DTR (.docx)
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- KPI MASTER REGISTER -->
        <div class="col-md-6 mb-4">
            <div class="card wizard-card h-100">
                <div class="card-header bg-kpi"><h5 class="mb-0"><i class="fas fa-file-excel"></i> KPI Master Register</h5></div>
                <div class="card-body d-flex flex-column">
                    <p class="small text-muted text-center mb-3">Monthly KPI Tracking Sheet (.xlsx)<br><em>*Chronologically sorted by Backdated Execution Date first, then Start Time.</em></p>
                    <form action="/export_excel" method="POST" class="mt-auto">
                        <label class="form-label fw-bold small">Select Target Month</label>
                        <input type="month" name="kpi_month" id="kpiMonthInput" class="form-control mb-3" required onchange="loadKpiPreview(this.value)">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-success w-50 fw-bold" onclick="loadKpiPreview(document.getElementById('kpiMonthInput').value)"><i class="fas fa-eye"></i> Preview Table</button>
                            <button type="submit" class="btn btn-success w-50 fw-bold"><i class="fas fa-file-download"></i> Download Excel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card wizard-card">
        <div class="card-header bg-preview d-flex justify-content-between align-items-center">
            <span><i class="fas fa-table"></i> Live KPI Master Register Preview</span>
            <span id="previewCountBadge" class="badge bg-warning text-dark">Select a month to preview</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                <table class="table table-striped table-hover table-sm mb-0" style="font-size: 13px;">
                    <thead class="table-dark" style="position: sticky; top: 0;">
                        <tr>
                            <th>Sl</th>
                            <th>Survey Ref #</th>
                            <th>Requestor</th>
                            <th>Assigned To</th>
                            <th>Received / Executed</th>
                            <th>Completed</th>
                            <th>Description of Survey Works</th>
                            <th>Clean Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="kpiPreviewBody">
                        <tr><td colspan="8" class="text-center py-4 text-muted">Click "Preview Table" above to inspect chronological KPI rows before downloading.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let selectedDatesSet = new Set();

    function formatYMD(dt) {
        const yyyy = dt.getFullYear();
        const mm = String(dt.getMonth() + 1).padStart(2, '0');
        const dd = String(dt.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    function getDayShortName(ymdStr) {
        const parts = ymdStr.split('-');
        if (parts.length !== 3) return '';
        const dt = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
        return dt.toLocaleDateString('en-US', { weekday: 'short' });
    }

    function renderSelectedDatesTray() {
        const sorted = Array.from(selectedDatesSet).sort();
        const tray = document.getElementById('selectedDatesTray');
        const countLbl = document.getElementById('selectedDatesCountLabel');
        const btn = document.getElementById('btnGenerateDtr');
        const csvInput = document.getElementById('selectedDatesCsv');

        csvInput.value = sorted.join(',');
        countLbl.textContent = `${sorted.length} Date${sorted.length === 1 ? '' : 's'} Queued for Word File:`;

        if (sorted.length === 0) {
            tray.innerHTML = `<span class="small text-muted fst-italic">Pick a date above to generate DTR...</span>`;
            btn.innerHTML = `<i class="fas fa-download"></i> Generate DTR (.docx)`;
            return;
        }

        tray.innerHTML = sorted.map(d => `
            <span class="date-chip">
                📅 ${d} (${getDayShortName(d)})
                <button type="button" class="date-chip-remove" onclick="removeDate('${d}')" title="Remove Date">&times;</button>
            </span>
        `).join('');

        if (sorted.length === 1) {
            btn.innerHTML = `<i class="fas fa-download"></i> Generate DTR for ${sorted[0]} (.docx)`;
        } else {
            btn.innerHTML = `<i class="fas fa-file-word"></i> Generate Combined DTR (${sorted.length} Dates in 1 .docx)`;
        }
    }

    // If only 1 date is currently in the tray and the user changes the main date picker, update it directly for 1-click convenience!
    function onSingleDateInputChange() {
        const val = document.getElementById('dtrDateInput').value;
        if (!val) return;
        if (selectedDatesSet.size <= 1) {
            selectedDatesSet.clear();
            selectedDatesSet.add(val);
            renderSelectedDatesTray();
        }
    }

    function addDateFromPicker() {
        const val = document.getElementById('dtrDateInput').value;
        if (!val) return;
        selectedDatesSet.add(val);
        renderSelectedDatesTray();
    }

    function removeDate(ymdStr) {
        selectedDatesSet.delete(ymdStr);
        renderSelectedDatesTray();
    }

    function resetToToday() {
        const todayStr = formatYMD(new Date());
        document.getElementById('dtrDateInput').value = todayStr;
        selectedDatesSet.clear();
        selectedDatesSet.add(todayStr);
        renderSelectedDatesTray();
    }

    function addQuickPreset(numDays) {
        selectedDatesSet.clear();
        for (let i = numDays - 1; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            selectedDatesSet.add(formatYMD(d));
        }
        renderSelectedDatesTray();
    }

    function addThisWeekPreset() {
        selectedDatesSet.clear();
        const now = new Date();
        const dayOfWeek = now.getDay(); // 0=Sun, 1=Mon, ...
        const diffToMon = (dayOfWeek === 0) ? 6 : (dayOfWeek - 1);
        for (let i = diffToMon; i >= 0; i--) {
            const d = new Date();
            d.setDate(now.getDate() - i);
            selectedDatesSet.add(formatYMD(d));
        }
        renderSelectedDatesTray();
    }

    function toggleRangeDrawer() {
        const box = document.getElementById('rangeDrawer');
        box.style.display = (box.style.display === 'none') ? 'block' : 'none';
    }

    function addDatesFromRange() {
        const sVal = document.getElementById('rangeStartInput').value;
        const eVal = document.getElementById('rangeEndInput').value;
        if (!sVal || !eVal) {
            alert('Please select both From Date and To Date.');
            return;
        }
        let dStart = new Date(sVal + 'T00:00:00');
        let dEnd = new Date(eVal + 'T00:00:00');
        if (dStart > dEnd) {
            const tmp = dStart; dStart = dEnd; dEnd = tmp;
        }
        selectedDatesSet.clear();
        let curr = new Date(dStart);
        let safety = 0;
        while (curr <= dEnd && safety < 62) {
            selectedDatesSet.add(formatYMD(curr));
            curr.setDate(curr.getDate() + 1);
            safety++;
        }
        renderSelectedDatesTray();
        document.getElementById('rangeDrawer').style.display = 'none';
    }

    function prepareDtrSubmit() {
        const pickerVal = document.getElementById('dtrDateInput').value;
        if (selectedDatesSet.size === 0 && pickerVal) {
            selectedDatesSet.add(pickerVal);
        }
        document.getElementById('selectedDatesCsv').value = Array.from(selectedDatesSet).sort().join(',');
    }

    window.onload = function() {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const todayStr = formatYMD(now);

        document.getElementById('dtrDateInput').value = todayStr;
        document.getElementById('rangeStartInput').value = todayStr;
        document.getElementById('rangeEndInput').value = todayStr;
        selectedDatesSet.add(todayStr);
        renderSelectedDatesTray();

        document.getElementById('kpiMonthInput').value = `${yyyy}-${mm}`;
        loadKpiPreview(`${yyyy}-${mm}`);
    };

    async function loadKpiPreview(monthStr) {
        const tbody = document.getElementById('kpiPreviewBody');
        const badge = document.getElementById('previewCountBadge');
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">Loading chronologically sorted KPI records...</td></tr>';
        try {
            const res = await fetch(`/api/preview_kpi?kpi_month=${encodeURIComponent(monthStr || '')}`);
            const data = await res.json();
            if (!data.success) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4">Error: ${data.message}</td></tr>`;
                return;
            }
            badge.textContent = `${data.count} Task(s) in ${monthStr || 'All Months'}`;
            if (data.rows.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No closed KPI tasks found for this month.</td></tr>';
                return;
            }
            tbody.innerHTML = data.rows.map(r => `
                <tr>
                    <td class="fw-bold">${r['Sl No']}</td>
                    <td class="font-monospace fw-bold text-primary">${r['Survey Ref. #']}</td>
                    <td>${r['Requestor']}</td>
                    <td>${r['Assigned to']}</td>
                    <td class="text-nowrap">${r['Date/Time Received']}</td>
                    <td class="text-nowrap">${r['Date/Time Completed']}</td>
                    <td class="fw-semibold">${r['Description of Survey Works']}</td>
                    <td class="text-muted">${r['Special Conditions / Remarks']}</td>
                </tr>
            `).join('');
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Network error loading KPI preview.</td></tr>';
        }
    }
</script>
</body>
</html>
